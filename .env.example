# Copy this file to .env and fill in the values.

# Your time zone. Days start at midnight in this zone.
TZ=Europe/Paris

# The user and group that own ./data on the host. Run `id` on the host to see yours.
PUID=1000
PGID=1000

# The key that encrypts your documents and Paperless tokens. Make one with:
#   openssl rand -base64 32
# Keep a copy in a safe place, apart from your backups. Without the key, the documents
# cannot be read again. If you leave it empty, the app makes ./data/secret.key.
DIARY_SECRET_KEY=

# Paperless-ngx (optional). The address the container can reach, for example a LAN IP.
PAPERLESS_URL=
# The address for "Open in Paperless" links on your devices. Empty: PAPERLESS_URL.
PAPERLESS_PUBLIC_URL=

# The address of the proxy in front of the app (Docktail, tailscale serve, a reverse proxy).
# Then the app sees the real address of each device. To find it, open the app, then run
# `docker logs health-diary`. Each request line starts with that address. Never use *.
FORWARDED_ALLOW_IPS=127.0.0.1
