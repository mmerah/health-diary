# Copy this file to .env and fill in the values.

# Your time zone. Days start at midnight in this zone.
TZ=Europe/Paris

# The user and group that own ./data on the host (run `id` on the NAS to see yours).
PUID=1000
PGID=1000

# Paperless-ngx (optional). Use an address the container can reach: a LAN IP,
# or the container name if both are on the same Docker network.
PAPERLESS_URL=
# Address for "Open in Paperless" links on your devices. Leave empty to use PAPERLESS_URL.
PAPERLESS_PUBLIC_URL=
# Default tag. Each user can change it, and saves their own Paperless token, in Profile.
PAPERLESS_TAG=medical

# Optional: a fixed setup code for the first account. Without it, a random code
# is printed in the log at start:  docker logs health-diary
# SETUP_CODE=

# Optional: days before a login expires (it renews while you use the app).
# SESSION_DAYS=30

# Key that encrypts the Paperless tokens in the database. Make one with:  openssl rand -base64 32
# Keep a copy apart from your backups. Without it, the server makes ./data/secret.key
# (then a copy of ./data holds both the tokens and the key).
# If you change it, each user must save their Paperless token again.
# DIARY_SECRET_KEY=

# Only behind a reverse proxy on another host or container: its address, so the app
# sees the real client address and HTTPS. Never use * here.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Optional: the largest Apple Health upload, and the largest size it may unpack to, in MB.
# MAX_IMPORT_MB=2048
# MAX_IMPORT_UNPACKED_MB=4096
